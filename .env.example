# Copier ce fichier en `.env` à la racine du dépôt (à côté de compose.yml), puis remplir les valeurs.
# docker compose le transmet au backend. Ne jamais commiter le vrai `.env`.

# Connexion avec GitHub (OAuth App : GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL de l'OAuth App : http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=Ov23li_exemple
# Secret de l'OAuth App : reste côté serveur, jamais dans le frontend.
GITHUB_CLIENT_SECRET=secret_exemple

# Clé de signature des tokens JWT : longue chaîne aléatoire.
JWT_SECRET=chaine_aleatoire_exemple
