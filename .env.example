# Copier ce fichier en `.env` à la racine du dépôt (à côté de compose.yml), puis remplir les valeurs.
# docker compose le transmet au backend. Ne jamais commiter le vrai `.env`.

# Connexion avec GitHub (OAuth App : GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL de l'OAuth App : http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=Ov23li_exemple
# Secret de l'OAuth App : reste côté serveur, jamais dans le frontend.
GITHUB_CLIENT_SECRET=secret_exemple

# Clé de signature des tokens JWT : longue chaîne aléatoire.
JWT_SECRET=chaine_aleatoire_exemple

# Connexion avec Google et Microsoft (OpenID Connect). Un fournisseur sans client ID/secret est
# désactivé : son bouton affiche « Bientôt ».
# Google Cloud > Clients OAuth, URI de redirection : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=exemple.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=secret_exemple
# Microsoft Entra > App registrations (plateforme Web), URI de redirection :
# http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=secret_exemple

# Facultatif : envoi de fichiers d'affiche (Supabase Storage). Sans ces valeurs, seul un lien d'image est accepté.
# SUPABASE_URL=https://exemple.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=cle_service_role_exemple
