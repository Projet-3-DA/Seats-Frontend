# Reverse proxy de Seats (#19). SITE_ADDRESS vient de deploy/.env :
# - « :80 » : HTTP simple, pour une adresse IP ou un nom interne au cégep ;
# - « seats.exemple.ca » : nom de domaine public, Caddy obtient alors un certificat HTTPS tout seul.
{$SITE_ADDRESS}

encode gzip

# API REST et temps réel (Socket.IO, WebSocket compris) : le backend.
handle /api/* {
	reverse_proxy backend:3000
}
handle /socket.io/* {
	reverse_proxy backend:3000
}

# Tout le reste : l'application web.
handle {
	reverse_proxy frontend:3000
}
