# Configuration de production (#19). Copier en deploy/.env sur le serveur, puis remplir.
# deploy/.env n'est jamais commité (.gitignore).

# Adresse publique de l'application, sans « / » final. Figée dans le bundle web au build :
# la changer demande de reconstruire (deploy/mettre-a-jour.sh --force).
SEATS_URL=http://10.0.0.42

# Adresse écoutée par Caddy : « :80 » pour une IP ou un nom interne, ou le nom de domaine public
# (ex. seats.exemple.ca) pour obtenir automatiquement un certificat HTTPS.
SITE_ADDRESS=:80

# Ports publiés sur le serveur (à changer si 80/443 sont déjà pris).
HTTP_PORT=80
HTTPS_PORT=443

# Mot de passe de la base Postgres locale. Longue chaîne aléatoire, ex. :
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé de signature des tokens JWT. Longue chaîne aléatoire, ex. :
#   openssl rand -hex 32
JWT_SECRET=

# Branche (ou tag) de Seats-Backend à déployer.
BACKEND_REF=main

# Affiches d'événements (Supabase Storage), facultatif.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=affiches
